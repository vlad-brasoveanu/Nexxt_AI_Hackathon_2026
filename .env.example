# Local synthetic demo only. Use a URL-safe random password (letters/digits).
CASECHECK_DB_PASSWORD=replace_with_random_32_character_value
CASECHECK_DATABASE_URL=postgresql+psycopg://casecheck:replace_with_random_32_character_value@localhost:5432/casecheck
CASECHECK_STORAGE_DIR=.runtime/documents
# false only for loopback HTTP demo. Enable for HTTPS deployments.
CASECHECK_SECURE_COOKIES=false
# Only when using the separate Vite development server:
CASECHECK_ALLOWED_ORIGINS=["http://127.0.0.1:5173"]
# Planned demo provider; adapter not enabled yet. Never put API keys in VITE_ vars.
# FEATHERLESS_API_KEY=
# CASECHECK_AI_MODEL=
